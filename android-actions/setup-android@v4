
name: Build CricketX-TV APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: actions/setup-android@v3

      - name: Extract project
        run: |
          mkdir source
          unzip -q CricketXTV-V3-CricAPI-Android-Source.zip -d source
          PROJECT_DIR=$(dirname "$(find source \( -name settings.gradle.kts -o -name settings.gradle \) | head -n 1)")
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Build APK
        run: gradle -p "$PROJECT_DIR" assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: CricketX-TV-APK
          path: source/**/app/build/outputs/apk/debug/*.apk
